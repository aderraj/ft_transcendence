// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserStatus {
  ONLINE
  OFFLINE
  IN_GAME
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

// ==================== USER ====================

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  email        String     @unique
  twoFaEnabled Boolean    @default(false)
  twoFaSecret  String?
  profilePic   String     @default("/images/default-avatar.png")
  status       UserStatus @default(OFFLINE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  tournaments            Tournament[]
  sentFriendRequests     FriendRequest[]       @relation("SentRequests")
  receivedFriendRequests FriendRequest[]       @relation("ReceivedRequests")
  friendshipsAsUser1     Friendship[]          @relation("FriendshipUser1")
  friendshipsAsUser2     Friendship[]          @relation("FriendshipUser2")
  matchesAsUser1         Match[]               @relation("MatchUser1")
  matchesAsUser2         Match[]               @relation("MatchUser2")
  sentMessages           ConversationMessage[] @relation("MessageFrom")
  receivedMessages       ConversationMessage[] @relation("MessageTo")
}

// ==================== TOURNAMENT ====================

model Tournament {
  id        String   @id @default(uuid())
  userId    String
  isBlocked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==================== FRIEND REQUEST ====================

model FriendRequest {
  id         String              @id @default(uuid())
  senderId   String
  receiverId String
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())

  // Relations
  sender   User @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
}

// ==================== FRIENDSHIP ====================

model Friendship {
  id        String   @id @default(uuid())
  userId1   String
  userId2   String
  isBlocked Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user1         User           @relation("FriendshipUser1", fields: [userId1], references: [id], onDelete: Cascade)
  user2         User           @relation("FriendshipUser2", fields: [userId2], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([userId1, userId2])
}

// ==================== CONVERSATION ====================

model Conversation {
  id           String             @id @default(uuid())
  friendshipId String
  status       ConversationStatus @default(ACTIVE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  // Relations
  friendship Friendship            @relation(fields: [friendshipId], references: [id], onDelete: Cascade)
  messages   ConversationMessage[]
}

// ==================== CONVERSATION MESSAGE ====================

model ConversationMessage {
  id             String   @id @default(uuid())
  conversationId String
  fromId         String
  toId           String
  content        String
  isVisible      Boolean  @default(true)
  createdAt      DateTime @default(now())

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  from         User         @relation("MessageFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to           User         @relation("MessageTo", fields: [toId], references: [id], onDelete: Cascade)
}

// ==================== MATCH ====================

model Match {
  id         String    @id @default(uuid())
  user1Id    String
  user2Id    String
  user1Score Int       @default(0)
  user2Score Int       @default(0)
  winnerId   String?
  createdAt  DateTime  @default(now())
  endedAt    DateTime?

  // Relations
  user1 User @relation("MatchUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 User @relation("MatchUser2", fields: [user2Id], references: [id], onDelete: Cascade)
}
