FROM node:20-alpine

WORKDIR /app

# Copy shared first
COPY shared ./shared

# Copy front to subdirectory (matches volume mount)
COPY front ./front

# Install shared dependencies
WORKDIR /app/shared
RUN npm install

# Install front dependencies
WORKDIR /app/front
RUN npm install

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host"]