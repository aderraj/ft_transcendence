# Database
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=transcendence
POSTGRES_DB=transcendence
DATABASE_URL=postgresql://transcendence:transcendence@localhost:5432/transcendence?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# 42 OAuth (get from https://profile.intra.42.fr/oauth/applications)
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
FORTYTWO_CALLBACK_URL=http://localhost:3000/api/auth/42/callback

# Environment
NODE_ENV=development
