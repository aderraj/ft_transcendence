# ===========================================
# TRANSCENDENCE ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and configure your values

# -------------------------------------------
# HOST CONFIGURATION
# -------------------------------------------
# The IP address or hostname where the application will be accessible
# Change this to your server's IP address or domain name
HOST_IP=10.14.57.32

# -------------------------------------------
# DATABASE CONFIGURATION
# -------------------------------------------
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=transcendence
POSTGRES_DB=transcendence

# Database URL for Prisma (use localhost:5433 for local access, postgres:5432 for container access)
DATABASE_URL=postgresql://transcendence:transcendence@postgres:5432/transcendence?schema=public

# -------------------------------------------
# SECURITY CONFIGURATION
# -------------------------------------------
# JWT Secret - MUST be changed in production!
# Generate a strong random string (minimum 32 characters)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-make-it-random-and-long

# -------------------------------------------
# 42 OAUTH CONFIGURATION
# -------------------------------------------
# Get these credentials from: https://profile.intra.42.fr/oauth/applications/new
# Redirect URI should be: https://${HOST_IP}:3001/api/auth/42/callback
OAUTH_42_CLIENT_ID=your_client_id_here
OAUTH_42_CLIENT_SECRET=your_client_secret_here

# -------------------------------------------
# APPLICATION CONFIGURATION
# -------------------------------------------
NODE_ENV=development
PORT=3001

# Enable/Disable HTTPS (true/false)
USE_HTTPS=true

# These URLs are automatically constructed from HOST_IP
# You don't need to change them unless using custom ports
FRONTEND_URL=https://${HOST_IP}:3000
OAUTH_42_CALLBACK_URL=https://${HOST_IP}:3001/api/auth/42/callback

# -------------------------------------------
# EMAIL CONFIGURATION (Gmail SMTP)
# -------------------------------------------
# For Gmail: Enable 2FA and generate an App Password
# Go to: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@transcendence.com

# ===========================================
# QUICK START GUIDE
# ===========================================
# 1. Copy this file: cp .env.example .env
# 2. Update HOST_IP with your server's IP
# 3. Add your 42 OAuth credentials
# 4. Configure email settings (optional)
# 5. Change JWT_SECRET to a random string
# 6. Run: docker-compose up -d --build
# ===========================================
