# ============================================
# ft_transcendence Environment Configuration
# ============================================
# Copy this file to .env and fill in the values
# Sensitive values are managed by Vault - only provide them
# on first startup to initialize Vault with your secrets

# ============================================
# General Configuration
# ============================================
NODE_ENV=development
HOST_IP=localhost

# ============================================
# OAuth Configuration (42 Intra)
# These are passed to Vault on first init
# ============================================
OAUTH_42_CLIENT_ID=your_42_client_id
OAUTH_42_CLIENT_SECRET=your_42_client_secret

# ============================================
# Google OAuth Configuration
# ============================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ============================================
# SMTP Configuration (for password reset emails)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@transcendence.local

# ============================================
# Note: The following are auto-generated by Vault
# and DO NOT need to be configured:
# - DATABASE_URL (constructed from Vault db_password)
# - JWT_SECRET (auto-generated by Vault)
# - POSTGRES_PASSWORD (auto-generated by Vault)
# - ELASTIC_PASSWORD (auto-generated by Vault)
# - GRAFANA_PASSWORD (auto-generated by Vault)
# ============================================

# ============================================
# Service Ports (for reference)
# ============================================
# WAF/Main Entry:    443 (HTTPS), 80 (HTTP redirect)
# Backend:           3001 (internal, accessible via /api)
# Frontend:          3000 -> 5173 (Vite dev server)
# Game Service:      3002 (accessible via /game)
# PostgreSQL:        5433 (external), 5432 (internal)
# Vault:             8200
# Kibana:            5601
# Grafana:           3003
# Prometheus:        9090
# Alertmanager:      9093
# ============================================
